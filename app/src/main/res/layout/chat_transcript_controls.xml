<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <Button android:id="@+id/chat_load_older"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="@string/chat_load_older" />
    <Button android:id="@+id/chat_pause"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="@string/chat_pause" />
    <Button android:id="@+id/chat_new_messages"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:visibility="gone" />
</LinearLayout>
