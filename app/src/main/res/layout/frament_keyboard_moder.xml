<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ToggleButton
            android:id="@+id/toggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textOff="@string/OpenEdit"
            android:textOn="@string/CloseEdit" />

        <TextView
            android:id="@+id/keyboard_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/keyboard_use_hint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/keyboard_add"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/keyboard_add"
            android:text="@string/keyboard_add_symbol"
            android:textSize="24sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/keyboard_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.zzf.bluetoothsmp.liaoTian.KeyboardCanvas
            android:id="@+id/keyboard_canvas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
